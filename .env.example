# Переменные для docker-compose. Скопируй в .env в корне проекта:
#   cp .env.example .env
# .env в корне используется ТОЛЬКО docker-compose, отдельно от backend/.env.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=messenger
POSTGRES_PORT=5432

# --- Backend ---
# Сгенерируй свой ключ: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-string
# DEBUG=True отдаёт OTP-код в ответе API — только для локальной разработки!
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000
SERVER_HOST=http://localhost:8000
