# Настройки окружения — скопируй в .env и заполни свои значения.
# ВНИМАНИЕ: .env не должен попадать в git (он уже в .gitignore).

# --- Приложение ---
APP_NAME=Messenger
# Сгенерируй свой ключ: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-super-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# DEBUG=True возвращает OTP-код прямо в ответе API — только для локальной разработки!
DEBUG=True

# --- База данных ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/messenger

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Хранилище файлов (локальное) ---
# Публичный адрес, по которому раздаются загруженные файлы
SERVER_HOST=http://localhost:8000
UPLOAD_DIR=uploads
MAX_AVATAR_SIZE=5242880
MAX_MESSAGE_FILE_SIZE=26214400

# --- SMS (Twilio), при DEBUG=True не используется ---
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
